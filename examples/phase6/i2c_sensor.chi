// Loaded I2C sensor slice: address ACK, writable byte capture, stretch, and
// deterministic response delay. SDA/SCL remain structurally open-drain.
protocol i2c_sensor {
    pin sda open_drain
    pin scl open_drain

    state idle {
        on fall(sda) when scl == 1 {
            reset address
            reset bits
            goto address
        }
    }

    state address {
        on rise(scl) {
            sample sda into address
            count bits
        }
        when bits == 8 && address == 0x84 -> ack
        when bits == 8 -> ignore
        within 100 us else -> idle
    }

    state ack {
        on fall(scl) {
            drive sda low
            goto ack_hold
        }
    }

    state ack_hold {
        on rise(scl) -> ack_release
    }

    state ack_release {
        on fall(scl) {
            drive sda release
            reset bits
            goto register
        }
    }

    state register {
        on rise(scl) {
            sample sda into address
            count bits
        }
        when bits == 8 -> register_ack
        within 100 us else -> idle
    }

    state register_ack {
        on fall(scl) {
            drive sda low
            goto release
        }
    }

    state release {
        on fall(scl) {
            drive sda release
            goto idle
        }
    }

    state ignore {
        on rise(scl) -> idle
    }
}

mutation stretch_response for i2c_sensor {
    when address == 0x84
    hold scl low for 2 cycles
}

mutation delay_response for i2c_sensor {
    when address == 0x84
    delay next action by 2 cycles
}
